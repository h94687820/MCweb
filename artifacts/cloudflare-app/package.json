{
  "name": "@workspace/cloudflare-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-vars.mjs && wrangler dev --port ${PORT:-8787} --ip 0.0.0.0",
    "build": "pnpm --filter @workspace/minecraft-hub run build",
    "deploy": "cd ../.. && ./deploy-cloudflare.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "catalog:",
    "typescript": "~5.9.3",
    "wrangler": "^4.148.0"
  }
}
